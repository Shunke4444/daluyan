# Copy to .env and fill in. Never commit .env (it is gitignored).
# Pick ONE provider, optionally a fallback.

SMS_PROVIDER=semaphore
# SMS_FALLBACK=iprog

# Semaphore (semaphore.co) - prepaid credits, PHP0.56/SMS
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=

# IPROG (iprogsms.com) - PHP1/SMS, packages from PHP100, free KYC trial credits
# IPROG_API_TOKEN=

# PhilSMS (philsms.com) - from PHP0.35, 5 free trial SMS
# PHILSMS_API_TOKEN=
# PHILSMS_SENDER=

# UniSMS (unismsapi.com) - PHP0.50/0.35 VAT-inc, PHP500 min top-up
# UNISMS_API_KEY=
# UNISMS_SENDER=

# Traccar SMS Gateway app (free, send-only, via your Android)
# TRACCAR_TOKEN=
# TRACCAR_URL=https://www.traccar.org/sms/

# Barangay label + speed up retry backoff for drills
DALUYAN_BRGY=Brgy Mahogany, Marilao
DEMO_FAST=1
